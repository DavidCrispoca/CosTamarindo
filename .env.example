# CosTamarindo - variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env real.
# Este archivo solo lleva nombres y valores de ejemplo.

# Entorno activo: dev | prod  (A.8.31)
ENV=dev

# ---------------------------------------------------------------------------
# Supabase (proyecto DEV)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref

# Claves nuevas (recomendadas): expiran y se pueden rotar.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Opcionales si el proyecto usa las claves legacy.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Pooler en modo sesion (5432): soporta sentencias preparadas. Es el que usa la API.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Pooler en modo transaccion (6543): solo si el backend es serverless.
# SUPABASE_DB_URL_TRANSACTION=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
BACKEND_JWT_SECRET=<48 bytes en hexadecimal>
BACKEND_JWT_TTL_MINUTES=30

# Deriva la credencial real de GoTrue a partir del PIN. Sin este valor los
# hashes de Supabase Auth no se pueden atacar por fuerza bruta de 10.000 PINs.
PIN_PEPPER=<32 bytes en hexadecimal>

# Deriva la clave HMAC de cada sesion. No se almacena en la base.
SESSION_MASTER_KEY=<32 bytes en hexadecimal>

SESSION_TTL_MINUTES=15
MAX_POINTS_PER_SECOND=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=60
CORS_ALLOWED_ORIGINS=https://juego.local
LOG_LEVEL=INFO

# Ref del proyecto DEV. Con ENV=prod y esta ref configurada, el backend se
# niega a arrancar (proteccion contra usar claves DEV en produccion).
# DEV_PROJECT_REFS=your-project-ref

# ---------------------------------------------------------------------------
# Ollama (Sg-AI) - se usa a partir de F7
# ---------------------------------------------------------------------------
OLLAMA_URL=http://sg-ai:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_NUM_PARALLEL=1

# ---------------------------------------------------------------------------
# TLS local (mkcert)
# ---------------------------------------------------------------------------
TLS_DOMAIN=juego.local

# ---------------------------------------------------------------------------
# Figma (solo exportacion de arte, no se usa en runtime)
# ---------------------------------------------------------------------------
FIGMA_TOKEN=
FIGMA_FILE_KEY=qI8jr7abLu6tIpL0MnL8Ol
