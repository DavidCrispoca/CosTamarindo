# ─────────────────────────────────────────────────────────────
#  CosTamarindo · variables de entorno
#  Copiar a .env y completar. NUNCA commitear el .env real.
# ─────────────────────────────────────────────────────────────

# Entorno activo: dev | prod
ENV=dev

# ── Supabase (proyecto DEV) ──────────────────────────────────
# PROD usa otro proyecto y otras claves; jamás en este archivo.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Backend ──────────────────────────────────────────────────
BACKEND_PORT=8000
SESSION_TTL_MINUTES=15
MAX_POINTS_PER_SECOND=12
CORS_ALLOWED_ORIGINS=https://juego.local

# ── Ollama (Sg-AI) ───────────────────────────────────────────
OLLAMA_URL=http://sg-ai:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_NUM_PARALLEL=1

# ── TLS local (mkcert) ───────────────────────────────────────
TLS_DOMAIN=juego.local
