# CosTamarindo · variables de entorno para PRODUCCIÓN (plantilla)
#
# Copiar a `.env` en el SERVIDOR y rellenar. NUNCA commitear el `.env`.
# Los secretos se generan nuevos para PROD (no reutilizar los de DEV):
#   openssl rand -hex 32
#
# Valores de Supabase PROD: en supabase.com → proyecto PROD → Project Settings → API / Database.

# ── Entorno ──────────────────────────────────────────────────────────────
ENV=prod

# ── Supabase PROD (el backend es el único que habla con él) ─────────────
SUPABASE_URL=https://<PROD_REF>.supabase.co
SUPABASE_PROJECT_REF=<PROD_REF>
SUPABASE_PUBLISHABLE_KEY=<clave_publishable_de_PROD>
SUPABASE_SECRET_KEY=<clave_secret_de_PROD>
# Pooler en modo SESIÓN (puerto 5432). Copiar de: Database → Connection string → "Session pooler".
SUPABASE_DB_URL=postgresql://postgres.<PROD_REF>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Secretos propios (generar con `openssl rand -hex 32`) ───────────────
BACKEND_JWT_SECRET=<32+ caracteres>
PIN_PEPPER=<16+ caracteres>
SESSION_MASTER_KEY=<16+ caracteres>

# ── Reglas de juego/seguridad (opcional, hay valores por defecto) ───────
# BACKEND_JWT_TTL_MINUTES=30
# SESSION_TTL_MINUTES=15
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_SECONDS=60

# ── Red / CORS ──────────────────────────────────────────────────────────
# La URL pública del juego (imprescindible en PROD).
CORS_ALLOWED_ORIGINS=https://<tu-dominio>
# La usa docker-compose.prod.yml para el CORS y, si aplica, para el dominio.
CT_PUBLIC_URL=https://<tu-dominio>

# ── Separación de entornos (A.8.31) ─────────────────────────────────────
# Ref del proyecto DEV: con ENV=prod, el backend se niega a arrancar si
# SUPABASE_PROJECT_REF está en esta lista.
DEV_PROJECT_REFS=jukyiwsteuzwrmzlgfme

# ── IA (opcional; los valores por defecto apuntan a sg-ai:11434) ────────
# OLLAMA_URL=http://sg-ai:11434
# OLLAMA_MODEL=qwen2.5:3b
